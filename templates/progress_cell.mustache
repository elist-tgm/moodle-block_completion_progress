    @template block_completion_progress_tgm/progress_cell

    One cell of the progress bar (context: an entry of "cells", plus instanceid/userid from the parent).

    Example context (json):
    {
        "instanceid": 1,
        "userid": 99,
        "activityid": 349,
        "haslink": "true",
        "completed": true,
        "hastype": true,
        "typeicon": "fa fa-dumbbell"
    }
}}<div class="progressBarCell
            {{#submittednotcomplete}}submittedNotComplete{{/submittednotcomplete}}
            {{#completed}}completed{{/completed}}
            {{#notcompleted}}notCompleted{{/notcompleted}}
            {{#futurenotcompleted}}futureNotCompleted{{/futurenotcompleted}}
            {{#unavailable}}unavailable{{/unavailable}}
            {{#hastype}}hasType{{/hastype}}"
    data-inforef="{{instanceid}}-{{userid}}-{{activityid}}"
    data-haslink="{{haslink}}">
    {{#typeicon}}<span class="typeIcon {{typeicon}}" aria-hidden="true"></span>{{/typeicon}}
    {{#firstnow}}
        <div class="nowDiv firstNow">
        {{#pix}} left, block_completion_progress_tgm {{/pix}}{{#str}} now_indicator, block_completion_progress_tgm {{/str}}
        </div>
    {{/firstnow}}
    {{#firsthalfnow}}
        <div class="nowDiv firstHalfNow">
        {{#pix}} left, block_completion_progress_tgm {{/pix}}{{#str}} now_indicator, block_completion_progress_tgm {{/str}}
        </div>
    {{/firsthalfnow}}
    {{#lasthalfnow}}
        <div class="nowDiv lastHalfNow">
        {{#str}} now_indicator, block_completion_progress_tgm {{/str}}{{#pix}} right, block_completion_progress_tgm {{/pix}}
        </div>
    {{/lasthalfnow}}
</div>