{{!
    @template block_completion_progress_tgm/completion_progress

    Produces a progress bar.

    Example context (json):
    {
        "novisibleactivities": false,
        "simple": false,
        "courseid": 1,
        "instanceid": 1,
        "userid": 99,
        "cellsperrow": 4,
        "displaynow": true,
        "useicons": true,
        "barwrap": false,
        "barscroll": false,
        "barsqueeze": true,
        "cells": [
            {
                "activityid": 349,
                "haslink": "not-allowed",
                "firstnow": true,
                "firsthalfnow": false,
                "lasthalfnow": false,
                "submittednotcomplete": true,
                "completed": false,
                "notcompleted": false,
                "futurenotcompleted": false,
                "unavailable": false,
                "hastype": true,
                "typeicon": "fa fa-dumbbell",
                "typelabel": "Üben",
                "activitylink": "https://url/",
                "activityicon": "https://url/",
                "activityname": "Text",
                "activityonclick": "void(0)",
                "infoicon": "tick",
                "infocomplete": true,
                "infopassed": false,
                "infofailed": false,
                "infoincomplete": false,
                "infosubmitted": false,
                "infounavailable": false,
                "availabilityinfo": ""
            }
        ],
        "grouped": false,
        "groups": [],
        "haslegend": true,
        "legend": [{"icon": "fa fa-dumbbell", "label": "Üben"}],
        "progresspercentage": "0%"
    }
}}
{{#novisibleactivities}}
    {{#str}} no_visible_activities_message, block_completion_progress_tgm {{/str}}
{{/novisibleactivities}}
{{^novisibleactivities}}
    <div class="block_completion_progress_tgm">
        <div class="barContainer" data-courseid="{{courseid}}" data-instanceid="{{instanceid}}" data-userid="{{userid}}">
            {{#barscroll}}
                <svg class="left-arrow-svg" height="30" width="30"><polygon points="30,0 0,15 30,30" class="triangle-polygon"></svg>
                <svg class="right-arrow-svg" height="30" width="30"><polygon points="0,0 30,15 0,30" class="triangle-polygon"></svg>
            {{/barscroll}}

            <div class="barRow
                    {{#useicons}}barWithIcons{{/useicons}}
                    {{#displaynow}}barWithNow{{/displaynow}}
                    {{#barsqueeze}}barModeSqueeze{{/barsqueeze}}
                    {{#barwrap}}barModeWrap{{/barwrap}}
                    {{#barscroll}}barModeScroll{{/barscroll}}">
                {{^grouped}}
                <div class="barRowCells" style="{{#barwrap}}flex-basis: calc(100% / {{cellsperrow}}){{/barwrap}}">
                    {{#cells}}{{> block_completion_progress_tgm/progress_cell }}{{/cells}}
                </div>
                {{/grouped}}
                {{#grouped}}
                <div class="barGroups">
                    {{#groups}}
                    <div class="barGroup" style="{{groupstyle}}">
                        {{#showheader}}
                        <div class="barGroupHeader" title="{{label}}">
                            {{#icon}}<span class="{{icon}}" aria-hidden="true"></span>{{/icon}}
                            <span class="barGroupLabel">{{label}}</span>
                        </div>
                        {{/showheader}}
                        <div class="barRowCells" style="{{cellsstyle}}">
                            {{#cells}}{{> block_completion_progress_tgm/progress_cell }}{{/cells}}
                        </div>
                    </div>
                    {{/groups}}
                </div>
                {{/grouped}}
            </div>
        </div>

        {{#haslegend}}
            <div class="taskTypeLegend">
                {{#legend}}
                    <span class="taskTypeLegendItem"><span class="typeLegendIcon {{icon}}" aria-hidden="true"></span>{{label}}</span>
                {{/legend}}
            </div>
        {{/haslegend}}

        {{#progresspercentage}}
            <div class="progressPercentage">
                {{#str}} progress, block_completion_progress_tgm {{/str}}: {{progresspercentage}}
            </div>
        {{/progresspercentage}}

        <div class="progressEventInfo">
            {{^simple}}
                {{#str}} mouse_over_prompt, block_completion_progress_tgm {{/str}}
                <a href="#" class="accesshide progressShowAllInfo">{{#str}} showallinfo, block_completion_progress_tgm {{/str}}</a>
            {{/simple}}
        </div>

        {{#cells}}
            <div class="progressEventInfo" data-inforef="{{instanceid}}-{{userid}}-{{activityid}}" style="display: none">
                {{#activitylink}}
                    <a href="{{activitylink}}" {{#activityonclick}} onclick="{{activityonclick}}" {{/activityonclick}}>
                        <img src="{{activityicon}}" class="moduleIcon" alt="" role="presentation">
                        {{{activityname}}}
                    </a>
                {{/activitylink}}
                {{^activitylink}}
                    <img src="{{activityicon}}" class="moduleIcon" alt="" role="presentation">
                    {{{activityname}}}
                {{/activitylink}}
                <br>
                {{#typelabel}}
                    <div class="taskType">
                        {{#typeicon}}<span class="{{typeicon}}" aria-hidden="true"></span>{{/typeicon}}
                        {{#str}} tasktype, block_completion_progress_tgm {{/str}}: {{typelabel}}
                    </div>
                {{/typelabel}}
                {{#infocomplete}}
                    {{#str}} completed, completion {{/str}}
                {{/infocomplete}}
                {{#infopassed}}
                    {{#str}} completion-pass, completion {{/str}}
                {{/infopassed}}
                {{#infofailed}}
                    {{#str}} completion-fail, completion {{/str}}
                {{/infofailed}}
                {{#infosubmitted}}
                    {{#str}} completion-n, completion {{/str}}
                    ({{#str}} submitted, block_completion_progress_tgm {{/str}})
                {{/infosubmitted}}
                {{#infoincomplete}}
                    {{#str}} completion-n, completion {{/str}}
                {{/infoincomplete}}
                {{#pix}} {{infoicon}}, block_completion_progress_tgm {{/pix}}
                <br>
                {{#infounavailable}}
                    <div class="unavailableInfo">
                        {{#str}} unavailable, block_completion_progress_tgm {{/str}}
                        {{#availabilityinfo}}<div class="availabilityinfo">{{{availabilityinfo}}}</div>{{/availabilityinfo}}
                    </div>
                {{/infounavailable}}
                {{#activityexpected}}
                    <div class="expectedBy">
                        {{#str}} time_expected, block_completion_progress_tgm {{/str}}:
                        {{#userdate}} {{activityexpected}}, {{#str}} strftimedate, langconfig {{/str}} {{/userdate}}
                    </div>
                {{/activityexpected}}
            </div>
        {{/cells}}
    </div>
{{/novisibleactivities}}
